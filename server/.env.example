# REQUIRED: inference API key used for Grok requests.
XAI_API_KEY=paste_your_xai_api_key_here

# REQUIRED: Clerk request authentication and active-session verification. The
# secret key is used server-side to confirm that each protected request belongs
# to a session whose current status is active. Never expose it to the website or
# extension. Authorized parties must be complete origins, not bare extension
# IDs. Separate multiple origins with commas.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=chrome-extension://replace_with_extension_id,http://localhost:3000

# OPTIONAL: local JWT signature verification. Paste the PEM public key with
# literal \n characters, or leave empty and Clerk will retrieve current signing
# keys. The active-session status lookup still calls Clerk's Backend API.
CLERK_JWT_KEY=

# Vision-capable xAI model. Keep the model that is currently working for you.
XAI_MODEL=grok-4.5

# Server settings. Render supplies PORT automatically.
PORT=8787
XAI_TIMEOUT_MS=180000
MAX_REQUEST_MB=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_MAX_CONCURRENT=2

# Optional: test the request flow without calling xAI.
MOCK_XAI=false

# OPTIONAL: required only for the live prepaid-credit display.
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=

# OPTIONAL: estimated output-token equivalent for the displayed balance.
XAI_OUTPUT_USD_PER_MILLION_TOKENS=6
