{
  "manifest_version": 3,
  "name": "SneakSolve MCQ Assistant",
  "version": "5.0.3",
  "key": "pjfanaeopegobidkbpnlmeegmkmnabmk"
  "description": "Capture visible tabs or selected zones, securely authenticate with Clerk, and solve single- or multiple-answer MCQs.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "offscreen",
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://snapgrok-api.onrender.com/*",
    "https://clerk.sneaksolve.com/*",
    "https://www.sneaksolve.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open SneakSolve settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/default16.png",
      "32": "icons/default32.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  },
  "commands": {
    "capture-full-screen": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Capture the full visible Chrome tab"
    },
    "capture-selected-zone": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Select and capture part of the visible Chrome tab"
    }
  },
  "icons": {
    "16": "icons/default16.png",
    "32": "icons/default32.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  }
}
