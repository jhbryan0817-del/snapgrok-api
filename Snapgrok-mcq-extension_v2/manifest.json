{
  "manifest_version": 3,
  "name": "SnapGrok MCQ Assistant",
  "version": "0.3.0",
  "description": "Capture the visible Chrome tab or a selected area, ask Grok for an A-E MCQ answer, and display the result through the toolbar icon.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://snapgrok-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open SnapGrok settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/default16.png",
      "32": "icons/default32.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  },
  "commands": {
    "capture-full-screen": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Capture the visible Chrome tab and solve the MCQ"
    },
    "capture-selected-zone": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Select an area of the visible Chrome tab and solve the MCQ"
    }
  },
  "icons": {
    "16": "icons/default16.png",
    "32": "icons/default32.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  }
}
