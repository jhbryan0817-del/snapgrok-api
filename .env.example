# REQUIRED: inference API key used for Grok requests.
XAI_API_KEY=paste_your_xai_api_key_here

# Vision-capable xAI model.
XAI_MODEL=grok-4.5

# Local server settings.
PORT=8787
XAI_TIMEOUT_MS=180000
MAX_REQUEST_MB=15
DATA_DIR=./data

# Test without calling xAI.
MOCK_XAI=false

# Optional xAI Management API configuration.
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=

# Optional estimated token-equivalent calculation.
XAI_OUTPUT_USD_PER_MILLION_TOKENS=6
