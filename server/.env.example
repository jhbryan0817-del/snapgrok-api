# REQUIRED: xAI inference API key. Never commit the real value.
XAI_API_KEY=paste_your_xai_api_key_here
XAI_MODEL=grok-4.5

# Render supplies PORT automatically. Keep this only for local testing.
PORT=8787
XAI_TIMEOUT_MS=180000
MAX_REQUEST_MB=15
MAX_INSTRUCTION_CHARACTERS=8000
MOCK_XAI=false

# REQUIRED: Clerk token verification.
# Recommended: paste the PEM public key from Clerk Dashboard -> API Keys -> JWT public key.
# The server accepts either real line breaks or literal \n characters.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_YOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# Alternative to CLERK_JWT_KEY. Do not set both unless necessary.
# CLERK_SECRET_KEY=sk_test_or_sk_live_here

# REQUIRED: comma-separated browser origins allowed to call this backend.
# Replace the extension ID with the ID shown at chrome://extensions.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000

# REQUIRED: allowed Clerk azp claims. Usually use the same frontend origins.
CLERK_AUTHORIZED_PARTIES=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000

# Production should remain true. Set false only for deliberate non-browser API testing.
REQUIRE_ALLOWED_ORIGIN=true

# Per-user abuse protection.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_CONCURRENT_REQUESTS_PER_USER=1

# Optional admin-only balance endpoint. Use Clerk user IDs, separated by commas.
# When empty, /api/balance is unavailable to everyone.
ADMIN_USER_IDS=
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=
XAI_OUTPUT_USD_PER_MILLION_TOKENS=6
