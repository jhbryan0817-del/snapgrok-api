# REQUIRED: xAI inference API key.
XAI_API_KEY=paste_your_xai_api_key_here
XAI_MODEL=grok-4.5

# Render supplies PORT automatically.
PORT=8787
XAI_TIMEOUT_MS=180000
MAX_REQUEST_MB=15
MOCK_XAI=false

# REQUIRED: Clerk backend credentials and accepted token origins.
# Keep the secret key in Render only. Never put it in the extension or GitHub.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=chrome-extension://replace_with_your_extension_id

# OPTIONAL: xAI prepaid-credit display.
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=
XAI_OUTPUT_USD_PER_MILLION_TOKENS=6
