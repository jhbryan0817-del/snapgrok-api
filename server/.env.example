# Required xAI inference configuration. Never commit the real key.
XAI_API_KEY=paste_your_xai_api_key_here
XAI_MODEL=grok-4.5

# Render supplies PORT automatically. Keep this only for local testing.
PORT=8787
XAI_TIMEOUT_MS=180000
MAX_REQUEST_MB=15
MAX_INSTRUCTION_CHARACTERS=8000
MOCK_XAI=false

# Required Clerk backend configuration.
# The secret key is needed to query the live Clerk session on every protected
# request. The publishable key identifies the same Clerk instance.
CLERK_SECRET_KEY=paste_production_secret_in_render_only
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc25lYWtzb2x2ZS5jb20k
REQUIRE_PRODUCTION_CLERK=true

# Optional local JWT verification key. The active-session lookup still requires
# CLERK_SECRET_KEY. Literal \n characters are accepted on one-line platforms.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA3ufR1DHET/lch2VdrJ/k\no6t0dmh1ZSH5EeCby8Qd2hQ7CDA0BUi68qHjtcmEwwOPYsaaBQsKX/4nfGGWw6Xm\n49RYyiSQVDS814W8sgVg7Mu0vCVjrZqS4UAh9wR/83gr3Jsz0MikWkhtNKgXvvOt\nZm3gM+9SJSI6SKMcioZhMl8FX+wGldVF2RyX1n4aFZrG2iWwIbrO0ZdyaGb4ffyh\nauEODV1nzcNeFqN+qiITc8DFR+o3i3M3KUylOJrIPrIjHSASX+n/0iXX8/UwwRz0\nM+g2RJrpqYHZY4Nvr6GyxlGYQNlep1BMJE/m0hdTCSUWFEOl7DJ68xX9EomNqONP\nFQIDAQAB\n-----END PUBLIC KEY-----"

# Required exact Chrome extension origin. Do not use wildcards.
ALLOWED_ORIGINS=chrome-extension://pjfanaeopegobidkbpnlmeegmkmnabmk
CLERK_AUTHORIZED_PARTIES=chrome-extension://pjfanaeopegobidkbpnlmeegmkmnabmk
REQUIRE_ALLOWED_ORIGIN=true

# Per-user fixed-window abuse protection (in memory, per Render process).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_CONCURRENT_REQUESTS_PER_USER=1

# Optional admin-only xAI balance endpoint.
ADMIN_USER_IDS=
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=
XAI_OUTPUT_USD_PER_MILLION_TOKENS=6
