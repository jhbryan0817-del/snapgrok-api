# Required xAI inference configuration. Never commit the real key.
XAI_API_KEY=paste_your_xai_api_key_here
XAI_MODEL=grok-4.5
ALLOWED_XAI_MODELS=grok-4.5

# Render supplies PORT automatically. Keep this only for local testing.
PORT=8787
XAI_TIMEOUT_MS=180000
XAI_MANAGEMENT_TIMEOUT_MS=10000
MAX_REQUEST_MB=15
MAX_INSTRUCTION_CHARACTERS=8000
MAX_SHORTCUT_NAME_CHARACTERS=100
MOCK_XAI=false

# Required Clerk backend configuration.
# The secret key is needed to query the live Clerk session on every protected
# request. The publishable key identifies the same Clerk instance.
CLERK_SECRET_KEY=paste_production_secret_in_render_only
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc25lYWtzb2x2ZS5jb20k
REQUIRE_PRODUCTION_CLERK=true
CLERK_TIMEOUT_MS=10000

# Optional defense-in-depth. Populate this only after the extension requests a
# Clerk token whose aud claim is set to the same API audience.
CLERK_AUDIENCE=

# Optional pinned JWT public key. Leave blank to let Clerk use the current key.
# If explicitly pinned, update it during Clerk key rotation. Literal \n
# characters are accepted on one-line platforms.
CLERK_JWT_KEY=

# Required exact Chrome extension origin. Do not use wildcards.
ALLOWED_ORIGINS=chrome-extension://pjfanaeopegobidkbpnlmeegmkmnabmk
CLERK_AUTHORIZED_PARTIES=chrome-extension://pjfanaeopegobidkbpnlmeegmkmnabmk
REQUIRE_ALLOWED_ORIGIN=true

# Admission and abuse protection. These counters are in memory and apply per
# Render process; they are not a subscription quota or a distributed limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_CONCURRENT_REQUESTS_PER_USER=1
GLOBAL_RATE_LIMIT_MAX_REQUESTS=3000
MAX_CONCURRENT_REQUESTS_GLOBAL=20
MAX_TRACKED_RATE_LIMIT_USERS=50000

# HTTP resource bounds.
REQUEST_BODY_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=240000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_HEADER_BYTES=16384

# Optional admin-only xAI balance endpoint.
ADMIN_USER_IDS=
XAI_MANAGEMENT_API_KEY=
XAI_TEAM_ID=
XAI_OUTPUT_USD_PER_MILLION_TOKENS=6
