{
  "manifest_version": 3,
  "name": "Zenaian MCQ Assistant",
  "version": "1.0.0",
  "description": "Capture visible or selected multiple-choice questions and receive proposed answers through the Chrome extension icon.",
  "minimum_chrome_version": "109",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://snapgrok-api.onrender.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.zenaian.com/*"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "action": {
    "default_title": "Open Zenaian settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/default16.png",
      "32": "icons/default32.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  },
  "commands": {
    "capture-full-screen": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Capture the full visible Chrome tab"
    },
    "capture-selected-zone": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Select and capture part of the visible Chrome tab"
    }
  },
  "icons": {
    "16": "icons/default16.png",
    "32": "icons/default32.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  }
}
